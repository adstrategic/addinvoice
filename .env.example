# Copy to .env and fill in. Docker compose reads .env automatically for the
# variable substitutions in compose.dev.yml.
#
#   cp .env.example .env && pnpm dev:ip
#
# Every key here is required — compose fails with a readable error if one is
# missing, rather than starting a stack that misbehaves later.

# Host LAN address the phone reaches Metro (8081) and the API (4000) on.
# `pnpm dev:ip` fills this in from `hostname -I`. Never localhost: a physical
# device cannot resolve it.
LAN_IP=

# Dev database credentials. The postgres service is created with these, and the
# backend and worker build their DATABASE_URL from them.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=addinvoices

# From the Clerk dashboard — the same key the web app uses. Publishable keys are
# meant to ship in client bundles and are not secrets.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
