{
  "name": "addinvoice",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "overrides": {
      "livekit-server-sdk>@livekit/protocol": "1.44.0"
    },
    "onlyBuiltDependencies": ["@clerk/shared", "core-js"]
  },
  "scripts": {
    "build": "turbo run build",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:push": "turbo run db:push",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev:backend": "turbo run dev --filter=@addinvoice/backend",
    "dev:frontend": "turbo run dev --filter=@addinvoice/frontend",
    "dev:pdf-service": "turbo run dev --filter=@addinvoice/pdf-service",
    "dev:agent": "turbo run dev --filter=@addinvoice/agent",
    "dev:mobile": "turbo run dev --filter=@addinvoice/mobile",
    "dev:ip": "bash scripts/set-lan-ip.sh",
    "dev:mobile": "turbo run dev --filter=@addinvoice/mobile"
  },
  "devDependencies": {
    "@livekit/agents": "~1.0.36",
    "prisma": "7.4.1",
    "turbo": "^2.9.5",
    "typescript": "^5.9.3"
  }
}
