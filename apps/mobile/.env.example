# Backend REST API. On a physical device this MUST be your machine's LAN IP,
# not localhost — the phone resolves localhost to itself.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Same Clerk publishable key as the web app (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
# EXPO_PUBLIC_* values are inlined into the JS bundle — never put a secret here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
